{
  "schemaVersion": 1,
  "rules": {
    "tapWindowSeconds": 0.18,
    "holdGraceSeconds": 0.25,
    "rollGraceSeconds": 0.5,
    "mineWindowSeconds": 0.09,
    "requireStepOnMines": false
  },
  "cases": [
    {
      "name": "hold-recovers-within-grace",
      "notes": [
        { "lane": 0, "type": "hold", "time": 1, "endTime": 2 }
      ],
      "inputs": [
        { "lane": 0, "action": "down", "time": 1 },
        { "lane": 0, "action": "up", "time": 1.4 },
        { "lane": 0, "action": "down", "time": 1.6 }
      ],
      "expected": [
        { "lane": 0, "type": "hold", "headJudgment": "Perfect", "bodyJudgment": "Held" }
      ]
    },
    {
      "name": "hold-let-go-after-grace",
      "notes": [
        { "lane": 1, "type": "hold", "time": 1, "endTime": 2 }
      ],
      "inputs": [
        { "lane": 1, "action": "down", "time": 1 },
        { "lane": 1, "action": "up", "time": 1.2 },
        { "lane": 1, "action": "down", "time": 1.6 }
      ],
      "expected": [
        { "lane": 1, "type": "hold", "headJudgment": "Perfect", "bodyJudgment": "LetGo" }
      ]
    },
    {
      "name": "roll-requires-repeated-taps",
      "notes": [
        { "lane": 2, "type": "roll", "time": 1, "endTime": 2.2 },
        { "lane": 3, "type": "roll", "time": 3, "endTime": 4.2 }
      ],
      "inputs": [
        { "lane": 2, "action": "down", "time": 1 },
        { "lane": 2, "action": "up", "time": 1.1 },
        { "lane": 2, "action": "down", "time": 1.4 },
        { "lane": 2, "action": "up", "time": 1.5 },
        { "lane": 2, "action": "down", "time": 1.8 },
        { "lane": 3, "action": "down", "time": 3 }
      ],
      "expected": [
        { "lane": 2, "type": "roll", "headJudgment": "Perfect", "bodyJudgment": "Held" },
        { "lane": 3, "type": "roll", "headJudgment": "Perfect", "bodyJudgment": "LetGo" }
      ]
    },
    {
      "name": "mine-detects-held-lane",
      "notes": [
        { "lane": 0, "type": "mine", "time": 1 },
        { "lane": 1, "type": "mine", "time": 1 }
      ],
      "inputs": [
        { "lane": 0, "action": "down", "time": 0.5 },
        { "lane": 0, "action": "up", "time": 1.2 }
      ],
      "expected": [
        { "lane": 0, "type": "mine", "judgment": "HitMine" },
        { "lane": 1, "type": "mine", "judgment": "AvoidMine" }
      ]
    },
    {
      "name": "missed-head-does-not-activate-hold",
      "notes": [
        { "lane": 0, "type": "hold", "time": 1, "endTime": 2 }
      ],
      "inputs": [
        { "lane": 0, "action": "down", "time": 1.25 }
      ],
      "expected": [
        { "lane": 0, "type": "hold", "headJudgment": "Miss", "bodyJudgment": "Missed" }
      ]
    }
  ]
}
